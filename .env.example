# URL pública canônica do site, usada para metadata, Open Graph e canonical URLs.
# Sem esta variável, o build usa o fallback de produção (https://impakto-festas.vercel.app).
NEXT_PUBLIC_SITE_URL=https://impakto-festas.vercel.app

# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_SUPABASE

# Chave privada usada exclusivamente no backend. Nunca use o prefixo VITE_.
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-SUA_CHAVE_PRIVADA
